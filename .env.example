# OpenAI-compatible gateway URL
GATEWAY_URL=https://integrate.api.nvidia.com/v1

# API key or bearer token
API_KEY=

# Override skills directory (default: .agents/skills)
# SKILLS_DIR=.agents/skills

# Verbose logging (set to 1)
# VERBOSE=1

# Skillgrade — agent API key (used by `make eval`)
# Supports: ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY
ANTHROPIC_API_KEY=

# GitLab personal access token (used by Cardea and `make doctor`)
GITLAB_PERSONAL_ACCESS_TOKEN=
